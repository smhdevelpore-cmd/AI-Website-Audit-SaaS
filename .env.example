# Copy to .env and fill in. Never commit .env.
# Server secrets must never appear in a VITE_ variable: those are compiled into the browser bundle.

# --- shared ---------------------------------------------------------------
NODE_ENV=development

# --- apps/api (server only) ----------------------------------------------
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security: never send to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379
# Token verification. Set one of these: the project's JWT secret (HS256), or the JWKS URL for
# asymmetric signing keys. Without either, the API cannot verify a token and says so.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
PAGESPEED_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LOG_LEVEL=info
AUDIT_MAX_PAGES=25
AUDIT_TIMEOUT_MS=30000
CRAWLER_USER_AGENT=SiteAuditBot/0.1 (+https://example.com/bot)
AUDIT_CONCURRENCY=2

# --- apps/web (browser, public) ------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
