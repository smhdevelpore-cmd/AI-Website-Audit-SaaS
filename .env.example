# Copy to .env and fill in. Never commit .env.
# Server secrets must never appear in a VITE_ variable: those are compiled into the browser bundle.

# --- shared ---------------------------------------------------------------
NODE_ENV=development

# --- apps/api (server only) ----------------------------------------------
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security: never send to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=
# Required to submit audits. Without it the API answers submissions with 503 rather than
# writing a queued row nothing will pick up. `docker compose up -d redis` starts one locally.
REDIS_URL=redis://localhost:6379
# Token verification. Set one of these: the project's JWT secret (HS256), or the JWKS URL for
# asymmetric signing keys. Without either, the API cannot verify a token and says so.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
# PageSpeed Insights. Without a key, audits record `metrics_status = 'skipped'` and the report says
# performance was measured by our own crawl.
PAGESPEED_API_KEY=
# AI explanations. The worker builds the explanation step only when BOTH the key and the model
# are set; otherwise every audit records `ai_status = 'skipped'` and the report says so.
LLM_API_KEY=
LLM_MODEL=
# OpenAI-compatible completions URL. Blank uses the OpenAI default.
LLM_ENDPOINT=
LOG_LEVEL=info
AUDIT_MAX_PAGES=25
# Audits one account may start in a rolling 24 hours.
AUDIT_DAILY_LIMIT=20
AUDIT_TIMEOUT_MS=30000
CRAWLER_USER_AGENT=SiteAuditBot/0.1 (+https://example.com/bot)
AUDIT_CONCURRENCY=2

# --- apps/web (browser, public) ------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
